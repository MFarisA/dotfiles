// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "your_agent": {
      "command": "path_to_executable",
      "args": [],
      "env": {}
    }
  },
  "agent": {
    "always_allow_tool_actions": true,
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    }
  },
  "vim_mode": false,
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "show_edit_predictions": false,
  "show_completions_on_input": true,
  "context_servers": {
    "mcp-server-context7": {
      "source": "extension",
      "enabled": true,
      "settings": {
        "default_minimum_tokens": "10000"
      }
    }
  },

  "languages": {
    "PHP": {
      "language_servers": ["intelephense", "!phpactor", "..."],
      "formatter": "language_server"
    }
  },
  "file_types": {
    "PHP": ["*.php"],
    "Blade": ["*.blade.php"]
  },
  "notification_panel": {
    "dock": "right"
  },
  "chat_panel": {
    "button": "never",
    "dock": "bottom"
  },
  "outline_panel": {
    "dock": "right"
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 10,
    "hide_root": true
  },
  "terminal": {
    "font_family": "FiraCode Nerd Font Mono",
    "font_size": 12,
    "line_height": "comfortable"
  },
  "minimap": {
    "show": "always",
    "thumb": "always",
    "thumb_border": "right_open",
    "current_line_highlight": null
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // above is default from Zed
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    // Laravel
    "**/node_modules",
    "**/vendor"
  ],
  "diagnostics": {
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null
    }
  }
}
